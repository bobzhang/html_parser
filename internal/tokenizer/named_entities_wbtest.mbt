    ("zscr", "\u{1D4CF}", false),
    ("zwj", "\u{200D}", false),
    ("zwnj", "\u{200C}", false),
  ]
  assert_eq(expected.length(), 2125)
  for (name, value, legacy) in expected {
    assert_eq(semicolon_named_entity_value(name), Some(value))
    assert_eq(semicolon_named_entity_value(name + "\u{0000}"), None)
    assert_eq(
      legacy_named_entity_value(name),
      if legacy {
        Some(value)
      } else {
        None
      },
    )
  }
}

///|
test "packed named entity lookup rejects unknown names and respects borrowed views" {
  for
    name in [
      "", "!amp", "Amp", "notinX", "😀", "amp\u{0000}", "CounterClockwiseContourIntegralx",
    ] {
    assert_eq(semicolon_named_entity_value(name), None)
    assert_eq(legacy_named_entity_value(name), None)
  }
  assert_eq(
    semicolon_named_entity_value("[NotEqualTilde]"[1:14]),
    Some("\u{2242}\u{0338}"),
  )
  assert_eq(legacy_named_entity_value("[Aacute]"[1:7]), Some("\u{00C1}"))
  let decoded = decode_entities_with_errors(
    "&notabcdefghijklmnopqrstuv;",
    in_attribute=false,
  )
  assert_eq(decoded.data.to_owned(), "¬abcdefghijklmnopqrstuv;")
  assert_eq(decoded.errors.length(), 1)
}
